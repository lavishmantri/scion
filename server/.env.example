# Scion Sync Server Configuration

# Server port (exposed on host)
PORT=3000

# Logging level: trace, debug, info, warn, error, fatal
# Use "debug" to see per-file push details, lock timing, git internals
LOG_LEVEL=info

# Host path to vault storage (mounted into container)
# On Raspberry Pi, typically: /home/pi/scion-vault
VAULT_HOST_PATH=./vault

# --- Axiom (optional) ---
# Sign up at https://axiom.co (free: 500 GB/mo, 30-day retention, 2 datasets)
# Create an API token at Settings > API Tokens (with ingest permission)

# API token — enables remote log shipping when set
AXIOM_TOKEN=

# Dataset for error/warning logs (warn+ level only)
# Create at axiom.co > Datasets > New Dataset (e.g. "scion-errors")
AXIOM_DATASET=

# Dataset for all request summaries (optional, uses second free dataset)
# Lightweight (~200 bytes per request). Create e.g. "scion-requests"
AXIOM_DATASET_REQUESTS=
